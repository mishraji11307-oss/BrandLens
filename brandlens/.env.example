# BrandLens Master Environment Configuration
# Project: BrandLens (Inkloom AI | CodeNexus India 2026 | Round 2 | Team V4Vantage)

# Server Environment (development / production)
ENVIRONMENT=development

# JWT Secret Key
SECRET_KEY=brandlens-super-secret-production-key-inkloom-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection
# SQLite default for zero-dependency local runs:
DATABASE_URL=sqlite:///./brandlens.db
# PostgreSQL with pgvector for production deployments:
# DATABASE_URL=postgresql+psycopg2://brandlens:brandlens_secure_2026@localhost:5432/brandlens_db

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25

# AI / LLM Configuration
# Set your preferred provider: "auto", "deterministic", "openai", "gemini", or "anthropic"
LLM_PROVIDER=auto
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Public Demo Mode (Enables 1-click judge evaluation)
ENABLE_PUBLIC_DEMO=true
DEMO_ORG_NAME=GlowCare Skincare

